\textbf{Appendix E: Formal Verification}

E.1 Process Calculus Model

\emph{Definition E.1:} Protocol specification in applied π-calculus:
\end{quote}

\begin{longtable}[]{@{}
  >{\raggedright\arraybackslash}p{(\columnwidth - 0\tabcolsep) * \real{1.0000}}@{}}
\toprule()
\begin{minipage}[b]{\linewidth}\raggedright
\begin{quote}
// Principal processes\\
let User(sk\_u: skey) =\\
new l: location;\\
new r: random;\\
let c = commit(l,r) in\\
let π = proveRange(l,r,{[}a,b{]}) in out(ch, (c,π));\\
in(ch, sigs: signature list); if verifyAll(sigs) then\\
event UserAccept(l,c,π)
\end{quote}\strut
\end{minipage} \\
\midrule()
\endhead
\bottomrule()
\end{longtable}

\begin{longtable}[]{@{}
  >{\raggedright\arraybackslash}p{(\columnwidth - 0\tabcolsep) * \real{1.0000}}@{}}
\toprule()
\begin{minipage}[b]{\linewidth}\raggedright
\begin{quote}
let Witness(sk\_w: skey) =\\
in(ch, (c:commitment, π:proof));
\end{quote}\strut
\end{minipage} \\
\midrule()
\endhead
\bottomrule()
\end{longtable}

\begin{longtable}[]{@{}
  >{\raggedright\arraybackslash}p{(\columnwidth - 0\tabcolsep) * \real{1.0000}}@{}}
\toprule()
\begin{minipage}[b]{\linewidth}\raggedright
\begin{quote}
if verifyRange(c,π,{[}a,b{]}) then let σ = sign(sk\_w, (c,π)) in out(ch,
σ);\\
event WitnessAccept(c,π)
\end{quote}\strut
\end{minipage} \\
\midrule()
\endhead
\bottomrule()
\end{longtable}

\begin{longtable}[]{@{}
  >{\raggedright\arraybackslash}p{(\columnwidth - 0\tabcolsep) * \real{1.0000}}@{}}
\toprule()
\begin{minipage}[b]{\linewidth}\raggedright
\begin{quote}
// System composition\\
process\\
(!User(sk\_u) \textbar{} !Witness(sk\_w) \textbar{} !Adversary)
\end{quote}\strut
\end{minipage} \\
\midrule()
\endhead
\bottomrule()
\end{longtable}

