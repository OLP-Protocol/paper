\emph{// Batch verification}\\
\textbf{fn}batch\_verify(proofs: \&{[}Proof{]})-\textgreater{}
Result\textless()\textgreater\{ \textbf{let}scalars:
Vec\textless\_\textgreater=proofs\\
.par\_iter()\\
.map(\textbar p\textbar random\_scalar())\\
.collect();
