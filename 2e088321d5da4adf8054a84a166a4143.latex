ProveDistance(pp, d, r\_d, {[}0,max\_d{]})\\
4. σ\_i = Sign\_SK\_Wi(PPR \textbar\textbar{} zk\_d)\\
5. Return PPRs = (w\_i.PK, zk\_d, σ\_i)
\end{quote}\strut
