\begin{quote}
\emph{Implementation G.2.2:} Network layer:
\end{quote}

\begin{longtable}[]{@{}
  >{\raggedright\arraybackslash}p{(\columnwidth - 0\tabcolsep) * \real{1.0000}}@{}}
\toprule()
\begin{minipage}[b]{\linewidth}\raggedright
\begin{quote}
\textbf{impl}NetworkLayer\{\\
\textbf{fn}broadcast(\&self,msg: Message)-\textgreater{}
Result\textless()\textgreater\{\\
\textbf{let}peers=self.get\_active\_peers();\\
\textbf{for}peer\textbf{in}peers\{\\
\textbf{iflet}Err(e)=self.send\_with\_retry(peer,msg.clone())\{
log::warn!("Failed to send to \{\}: \{\}",peer,e); \textbf{continue};\\
\}\\
\}\\
Ok(())\\
\}
\end{quote}\strut
\end{minipage} \\
\midrule()
\endhead
\bottomrule()
\end{longtable}

\begin{longtable}[]{@{}
  >{\raggedright\arraybackslash}p{(\columnwidth - 0\tabcolsep) * \real{1.0000}}@{}}
\toprule()
\begin{minipage}[b]{\linewidth}\raggedright
\begin{quote}
\textbf{fn}handle\_incoming(\&self,msg: Message)-\textgreater{}
Result\textless()\textgreater\{
\textbf{if}!self.verify\_message(\&msg)\{\\
\textbf{return}Err(Error::InvalidMessage);\\
\}\\
\textbf{match}msg.header.msg\_type\{\\
MessageType::PPR=\textgreater self.handle\_ppr(msg),\\
MessageType::PPRs=\textgreater self.handle\_pprs(msg),
MessageType::PPC=\textgreater self.handle\_ppc(msg),\\
\}\\
\}
\end{quote}\strut
\end{minipage} \\
\midrule()
\endhead
\bottomrule()
\end{longtable}

